import os; os.environ.setdefault("OMP_NUM_THREADS", "64")   # >= #instances (12); set before allo
import allo
from allo.ir.types import int32, int1, UInt, Stream
import allo.dataflow as df
import numpy as np

# =====================================================================================
# RaveNoC-style router, Stage 0: ONE node, 5 ports, ONE kernel per port.
#
# Architecture follows aignacio/ravenoc (MIT, (c) 2021 Anderson Ignacio) -- structure
# reimplemented in Allo, no source carried over.  Reference: src/router/{input_module,
# input_router, output_module, rr_arbiter}.sv.
#
# WHAT THIS TAKES FROM RaveNoC (and our own routers do not have):
#   * a per-port MODULE split: RaveNoC has one input_module and one output_module per
#     port, wired by handshakes, instead of one monolithic router body.  Here that is
#     literally one @df.kernel per port -- 5 in_port + 5 out_port PEs per router.
#   * arbitration lives in the OUTPUT module, one round-robin per output, with the
#     rotating pointer as persistent state (RaveNoC: mask_ff/grant_ff in rr_arbiter.sv).
#   * a REGISTERED output (RaveNoC: the always_ff at the end of output_module.sv).
#     Emitting last pass's winner is also what keeps a mesh of these from forming a
#     combinational loop when the links later become depth-0 Channels.
#   * XY routing decided from the flit header at the input, once (input_router.sv).
#
# STAGE 0 SIMPLIFICATIONS (each is a later stage, not an oversight):
#   * ONE virtual channel.  RaveNoC has NumVirtChn per input port, each with its own
#     vc_buffer + its own rr_arbiter instance.  VCs are Stage 1.
#   * SINGLE-FLIT packets.  RaveNoC is wormhole: HEAD/BODY/TAIL, where the head fixes
#     the route and the VC holds it until the tail passes.  Multi-flit + route lock is
#     Stage 2.
#   * Stream links, not Channel[valid_ready].  RaveNoC's s_flit_req_t/s_flit_resp_t is
#     exactly valid/ready, but Channel is SystemC-only -- Stream runs on the JIT
#     simulator so the routing/arbitration can be checked numerically first.  The link
#     swap is Stage 3.
#
# DELIBERATE DEVIATION -- where arbitration happens:
#   RaveNoC grants BEFORE any flit moves: input modules raise request wires
#   (s_router_ports_t), the output module's arbiter grants one, and only then does the
#   flit cross.  A Stream has no peek, so polling to arbitrate would CONSUME the losers.
#   Stage 0 therefore latches each source into a per-source register at the output and
#   arbitrates over the latched flits.  Same grant order, still lossless, but one extra
#   pipeline stage and the buffering sits at the output rather than the input.  A true
#   request/grant handshake arrives in Stage 2 alongside VCs.
# =====================================================================================

# Port indices -- RaveNoC routes_t order (NORTH, SOUTH, WEST, EAST, LOCAL)
NORTH, SOUTH, WEST, EAST, LOCAL = 0, 1, 2, 3, 4
DIR = 5

# This node's coordinates (RaveNoC: ROUTER_X_ID / ROUTER_Y_ID)
ROUTER_X = 1
ROUTER_Y = 1

# flit layout (LSB-first): data[0:16] x_dest[16:19] y_dest[19:22]
# No valid bit: validity is the try_get/try_put `ok` flag.
DW = 16
W = 3
X_LO = DW
Y_LO = DW + W
PS = DW + 2 * W          # 22
CMASK = (1 << W) - 1

NUM_IT = 32              # per-PE pass budget (see router_XY_nb.py header)
LANELEN = 8              # host lanes per port


@df.region()
def router_rvn(inj: int32[DIR, LANELEN], dlv: int32[DIR, LANELEN]):
    # external links (one per port) and the internal crossbar.
    ext_in:  Stream[UInt(PS), 4][DIR]        # drv      -> in_port i
    xbar:    Stream[UInt(PS), 2][DIR, DIR]   # in_port i -> out_port o
    ext_out: Stream[UInt(PS), 4][DIR]        # out_port o -> col

    # ── INPUT MODULE (RaveNoC input_module = input_router + input_datapath) ──────────
    # Latches one flit, computes its route ONCE from the header, then holds it until the
    # crossbar accepts it.  Holding-until-accepted is what makes the router lossless:
    # a refused flit is retried next pass rather than dropped.
    @df.kernel(mapping=[DIR], args=[])
    def in_port():
        i = df.get_pid()
        held: UInt(PS) = 0       # the latched flit
        hvld: int32 = 0          # is one latched?
        hdst: int32 = 0          # its routed output port (computed once, at latch time)
        stalls: int32 = 0        # passes the crossbar refused it (backpressure counter)

        for t in range(NUM_IT):
            # (1) accept a new flit only when the previous one has left
            if hvld == 0:
                v: UInt(PS) = 0
                ok: int1 = 0
                v, ok = ext_in[i].try_get()
                if ok == 1:
                    held = v
                    # ── route compute (RaveNoC input_router.sv, XYAlg branch) ──
                    # x first, then y, then eject.  x_dest > mine -> SOUTH, < -> NORTH;
                    # y_dest < mine -> WEST, > -> EAST; both equal -> LOCAL.
                    xd: int32 = (v >> X_LO) & CMASK
                    yd: int32 = (v >> Y_LO) & CMASK
                    if xd == ROUTER_X and yd == ROUTER_Y:
                        hdst = LOCAL
                    elif xd == ROUTER_X:
                        if yd < ROUTER_Y:
                            hdst = WEST
                        else:
                            hdst = EAST
                    else:
                        if xd > ROUTER_X:
                            hdst = SOUTH
                        else:
                            hdst = NORTH
                    hvld = 1

            # (2) drive the crossbar.  `xbar[i, hdst]` is ILLEGAL -- a stream-array index
            # must be a compile-time constant -- so emit one STATIC call site per output
            # and gate it on the runtime route.  meta_for unrolls at build time; only the
            # `if hdst == o` test is hardware.
            if hvld == 1:
                with allo.meta_for(0, DIR) as o:
                    if hdst == o:
                        w: int1 = xbar[i, o].try_put(held)
                        # The ok flag MUST be read or the whole put is silently deleted
                        # (MemRefDCE erases an scf.if whose result is unused, side effects
                        # and all).  Counting stalls both keeps it alive and measures
                        # backpressure honestly.
                        if w == 1:
                            hvld = 0
                        else:
                            stalls += 1

    # ── OUTPUT MODULE (RaveNoC output_module + rr_arbiter) ──────────────────────────
    # Per pass: emit last pass's winner (registered output), latch whatever the crossbar
    # offers, then round-robin one latched flit into the output register.
    @df.kernel(mapping=[DIR], args=[])
    def out_port():
        o = df.get_pid()
        hold: UInt(PS)[DIR] = 0   # one latch per source port (the crossbar register)
        hvld: int32[DIR] = 0      # which sources currently hold a flit
        rr: int32 = 0             # round-robin pointer (RaveNoC rr_arbiter mask_ff)
        oreg: UInt(PS) = 0        # the registered output (always_ff)
        ovld: int32 = 0

        for t in range(NUM_IT):
            # (a) EMIT FIRST: what leaves this pass was decided LAST pass. That one-pass
            # delay is the output register, and it is what stops a mesh of these routers
            # becoming a combinational loop once the links are depth-0.
            if ovld == 1:
                e: int1 = ext_out[o].try_put(oreg)
                if e == 1:
                    ovld = 0

            # (b) LATCH: take at most one flit per source into its own register. Done
            # before arbitration because try_get consumes -- we cannot look without
            # taking, so every source gets a private slot and nothing is lost.
            with allo.meta_for(0, DIR) as s:
                if hvld[s] == 0:
                    gv: UInt(PS) = 0
                    gk: int1 = 0
                    gv, gk = xbar[s, o].try_get()
                    if gk == 1:
                        hold[s] = gv
                        hvld[s] = 1

            # (c) ARBITRATE: scan the latches starting at rr, first valid wins, then the
            # pointer moves past the winner so it drops to lowest priority (no starvation).
            # Only rotates on an actual grant, so a blocked output does not burn fairness.
            if ovld == 0:
                won: int32 = 0
                for k in range(DIR):
                    sidx: int32 = rr + k
                    if sidx >= DIR:
                        sidx -= DIR
                    if won == 0 and hvld[sidx] == 1:
                        oreg = hold[sidx]
                        hvld[sidx] = 0
                        ovld = 1
                        won = 1
                        nxt: int32 = sidx + 1
                        if nxt >= DIR:
                            nxt -= DIR
                        rr = nxt

    # ── host driver: single owner of `inj`, fans out to the per-port ext_in streams ──
    @df.kernel(mapping=[1], args=[inj])
    def drv(din: int32[DIR, LANELEN]):
        sp: int32[DIR] = 0
        for t in range(NUM_IT):
            with allo.meta_for(0, DIR) as i:
                if sp[i] < LANELEN:
                    w: UInt(PS) = din[i, sp[i]]
                    if w != 0:                      # 0 = empty lane
                        ok: int1 = ext_in[i].try_put(w)
                        if ok == 1:
                            sp[i] += 1
                    else:
                        sp[i] += 1

    # ── host collector: single owner of `dlv`, drains every ext_out stream ──
    @df.kernel(mapping=[1], args=[dlv])
    def col(dout: int32[DIR, LANELEN]):
        kp: int32[DIR] = 0
        for t in range(NUM_IT):
            with allo.meta_for(0, DIR) as o:
                wv: UInt(PS) = 0
                wk: int1 = 0
                wv, wk = ext_out[o].try_get()
                if wk == 1 and kp[o] < LANELEN:
                    dout[o, kp[o]] = wv
                    kp[o] += 1


def pack(data, x, y):
    """Build a flit: payload + destination coordinates."""
    return int(data | (x << X_LO) | (y << Y_LO))


PORT_NAME = {NORTH: "N", SOUTH: "S", WEST: "W", EAST: "E", LOCAL: "L"}


def run(sim, seeds, label):
    """seeds: list of (in_port, lane, data, x_dest, y_dest). Returns the dlv array."""
    inj = np.zeros((DIR, LANELEN), dtype=np.int32)
    dlv = np.zeros((DIR, LANELEN), dtype=np.int32)
    for p, lane, data, x, y in seeds:
        inj[p, lane] = pack(data, x, y)
    sim(inj, dlv)
    print(f"\n--- {label} ---")
    return dlv


def arrived(dlv, port):
    return [int(dlv[port, k]) & 0xFFFF for k in range(LANELEN)]


if __name__ == "__main__":
    sim = df.build(router_rvn, target="simulator")

    # T1: a flit on each non-local input addressed to THIS node must eject on LOCAL.
    dlv = run(sim, [(p, 0, 0x100 + p, ROUTER_X, ROUTER_Y)
                    for p in (NORTH, SOUTH, WEST, EAST)],
              "T1: 4 inputs -> LOCAL (ejection)")
    got = arrived(dlv, LOCAL)
    ok1 = all((0x100 + p) in got for p in (NORTH, SOUTH, WEST, EAST))
    for p in (NORTH, SOUTH, WEST, EAST):
        print(f"  in {PORT_NAME[p]} -> LOCAL : "
              f"{'ok' if (0x100 + p) in got else 'MISSING'}")
    print("T1", "PASS" if ok1 else "FAIL")

    # T2: flits injected locally must leave on the port XY picks for each destination.
    #     x<X -> NORTH, x>X -> SOUTH, y<Y -> WEST, y>Y -> EAST.
    cases = [(0x201, ROUTER_X - 1, ROUTER_Y, NORTH),
             (0x202, ROUTER_X + 1, ROUTER_Y, SOUTH),
             (0x203, ROUTER_X,     ROUTER_Y - 1, WEST),
             (0x204, ROUTER_X,     ROUTER_Y + 1, EAST)]
    ok2 = True
    dlv = run(sim, [(LOCAL, k, d, x, y) for k, (d, x, y, _) in enumerate(cases)],
              "T2: LOCAL -> each direction (XY routing)")
    for d, x, y, want in cases:
        hit = d in arrived(dlv, want)
        print(f"  dest({x},{y}) -> {PORT_NAME[want]} : {'ok' if hit else 'MISSING'}")
        ok2 = ok2 and hit
    print("T2", "PASS" if ok2 else "FAIL")

    # T3: two inputs contend for the SAME output on the same pass. Unlike the bufferless
    #     router_XY_nb.py, NOTHING may be dropped -- the loser is latched and wins later.
    dlv = run(sim, [(NORTH, 0, 0x301, ROUTER_X, ROUTER_Y + 1),
                    (SOUTH, 0, 0x302, ROUTER_X, ROUTER_Y + 1)],
              "T3: 2 inputs contend for EAST (must be lossless)")
    east = arrived(dlv, EAST)
    both = (0x301 in east) and (0x302 in east)
    print(f"  0x301 : {'delivered' if 0x301 in east else 'LOST'}")
    print(f"  0x302 : {'delivered' if 0x302 in east else 'LOST'}")
    print("T3", "PASS (lossless)" if both else "FAIL (a flit was dropped)")

    # T4: fairness -- 4 inputs all target EAST, several flits each. Round-robin must
    #     serve them in rotation; no source may be starved.
    seeds = []
    for p in (NORTH, SOUTH, WEST, LOCAL):
        for lane in range(3):
            seeds.append((p, lane, 0x400 + 0x10 * p + lane, ROUTER_X, ROUTER_Y + 1))
    dlv = run(sim, seeds, "T4: 4 sources -> EAST, round-robin fairness")
    east = arrived(dlv, EAST)
    per_src = {p: sum(1 for lane in range(3)
                      if (0x400 + 0x10 * p + lane) in east)
               for p in (NORTH, SOUTH, WEST, LOCAL)}
    for p, n in per_src.items():
        print(f"  source {PORT_NAME[p]} : {n}/3 delivered")
    ok4 = all(n > 0 for n in per_src.values())
    print("T4", "PASS (no source starved)" if ok4 else "FAIL (a source got nothing)")

    print("\nper-PE cycles:", sim.get_cycles().per_pe)
